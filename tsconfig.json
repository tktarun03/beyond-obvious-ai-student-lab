{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@lab/ai": ["packages/ai/src/index.ts"],
      "@lab/ai/*": ["packages/ai/src/*"],
      "@lab/auth": ["packages/auth/src/index.ts"],
      "@lab/auth/*": ["packages/auth/src/*"],
      "@lab/database": ["packages/database/src/index.ts"],
      "@lab/database/*": ["packages/database/src/*"],
      "@lab/observability": ["packages/observability/src/index.ts"],
      "@lab/observability/*": ["packages/observability/src/*"],
      "@lab/shared": ["packages/shared/src/index.ts"],
      "@lab/shared/*": ["packages/shared/src/*"],
      "@lab/ui": ["packages/ui/src/index.ts"],
      "@lab/ui/*": ["packages/ui/src/*"],
      "@lab/validation": ["packages/validation/src/index.ts"],
      "@lab/validation/*": ["packages/validation/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "projects/**/*.ts",
    "projects/**/*.tsx",
    "*.ts",
    "*.mts",
    "**/next-env.d.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist", "**/sample-repo/**"]
}
