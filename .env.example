# =============================================================================
# Beyond the Obvious — AI Student Lab
# Copy to .env.local at the repo root:   cp .env.example .env.local
#
# The defaults below run EVERY project with no API key, no cloud account and no
# cost. Change them only when you are ready to pay for the real thing.
#
# .env.local is git-ignored. Never commit a real key. If you leak one, rotate it
# immediately — revoking is cheap, an abused key is not.
# =============================================================================

# -----------------------------------------------------------------------------
# AI MODE
# -----------------------------------------------------------------------------
# mock  = deterministic canned responses. No key, no network, no cost.
#         Evals are reproducible, CI is free, and the UI is fully usable.
# live  = real Gemini calls. Requires GEMINI_API_KEY.
AI_MODE=mock

# Server-side only. There is deliberately no NEXT_PUBLIC_ variant: anything with
# that prefix is compiled into the browser bundle and readable by every visitor.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ids. Flash-class models are the default because this is a teaching repo
# and a student should not need a budget to finish an exercise.
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Cost guard rails. The provider refuses calls beyond these caps.
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Per-session token budget. Set to 0 to disable (not recommended while learning).
AI_SESSION_TOKEN_BUDGET=200000

# -----------------------------------------------------------------------------
# DATABASE MODE
# -----------------------------------------------------------------------------
# memory   = in-process store, wiped on restart. Zero setup.
# firebase = Cloud Firestore via the Admin SDK (server-side only).
DB_MODE=memory

# Only needed when DB_MODE=firebase.
# Create a service account, download the JSON, and paste the three values here.
# Do NOT commit the JSON file — the .gitignore blocks serviceAccount*.json.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes from the JSON file; the loader converts them.
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# AUTHENTICATION MODE
# -----------------------------------------------------------------------------
# dev      = signed cookie session with a seeded demo user. Real session handling,
#            real authorization checks, no external dependency.
# firebase = Firebase Authentication ID tokens verified server-side.
AUTH_MODE=dev

# Signs the dev session cookie. Any random 32+ char string locally.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public Firebase web config (safe to expose — these identify, they do not
# authorise). Only needed when AUTH_MODE=firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# UPLOAD LIMITS (security control — see SECURITY.md)
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_UPLOADS_PER_USER=25

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# pretty = human-readable in a terminal. json = one object per line, for a log sink.
LOG_FORMAT=pretty
